{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAVoR quality filter report",
  "type": "object",
  "required": [
    "total_generated_samples",
    "passed_samples",
    "filter_config"
  ],
  "properties": {
    "filter_config": {
      "type": "object",
      "required": [
        "min_output_words",
        "min_distinct_bigram_ratio"
      ]
    }
  },
  "additionalProperties": true
}
